{
  "comment": [
    "The wire records are registered by the metadata modules/ipc generates, since a hand-written",
    "list of them goes stale the moment one is added and every call that touches the missing record",
    "answers 500. What is left here is what only this binary reaches."
  ],
  "reflection": [
    {
      "type": "net.hollowcube.apiserver.job.CompactReplay",
      "allDeclaredFields": true,
      "allDeclaredMethods": true,
      "allDeclaredConstructors": true
    },
    {
      "comment": "logback instantiates the encoder named in logback-prod.xml by name, so nothing in the image graph reaches it",
      "type": "net.hollowcube.apiserver.common.JsonLogEncoder",
      "allDeclaredMethods": true,
      "allDeclaredConstructors": true
    }
  ],
  "resources": [
    { "glob": "logback.xml" },
    { "glob": "logback-prod.xml" },
    { "glob": "META-INF/services/ch.qos.logback.classic.spi.Configurator" },
    { "glob": "META-INF/services/com.sun.net.httpserver.spi.HttpServerProvider" },
    { "glob": "META-INF/services/java.net.spi.InetAddressResolverProvider" },
    { "glob": "META-INF/services/java.nio.channels.spi.SelectorProvider" },
    { "glob": "META-INF/services/java.time.zone.ZoneRulesProvider" },
    { "glob": "META-INF/services/org.slf4j.spi.SLF4JServiceProvider" }
  ]
}
