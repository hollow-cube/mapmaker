<!-- Selected by -Dlogback.configurationFile in the deploy Dockerfile; logback.xml is what a local
     run gets. The same flat json the api-server writes, so one Loki query spans both. -->
<configuration>
    <appender name="JSON" class="ch.qos.logback.core.ConsoleAppender">
        <encoder class="net.hollowcube.apiserver.common.JsonLogEncoder"/>
    </appender>

    <root level="INFO">
        <appender-ref ref="JSON"/>
    </root>
    <logger name="com.zaxxer.hikari" level="INFO"/>
    <logger name="org.postgresql" level="WARN"/>
</configuration>
