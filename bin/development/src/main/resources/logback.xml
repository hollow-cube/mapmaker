<!--
  The development server's own, which it needs because it now depends on bin:api-server and
  bin:api-worker for the ipc implementations it hosts, and each of those ships a logback.xml of its
  own. Logback takes the first one on the classpath; this module's resources come before any
  dependency's jar, so this is the one that wins.

  Keep it in step with bin/config's, which is what every other game server here uses.
-->
<configuration>
    <appender name="STDOUT" class="ch.qos.logback.core.ConsoleAppender">
        <encoder>
            <pattern>%d{HH:mm:ss.SSS} [%thread] %-5level %logger{36} - %msg%n</pattern>
        </encoder>
    </appender>

    <root level="INFO">
        <appender-ref ref="STDOUT"/>
    </root>
    <logger name="net.minestom.server" level="INFO"/>
    <logger name="io.netty" level="WARN"/>
    <logger name="io.grpc" level="WARN"/>
    <logger name="io.helidon" level="WARN"/>
    <logger name="jdk.event.security" level="WARN"/>
    <logger name="sun.net.www" level="WARN"/>
    <logger name="com.github.benmanes.caffeine.cache" level="ERROR"/>
    <!-- The pool and driver the hosted api implementations open. -->
    <logger name="com.zaxxer.hikari" level="INFO"/>
    <logger name="org.postgresql" level="WARN"/>
</configuration>
