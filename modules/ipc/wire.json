        "get-trace": {
          "params": [
            {
              "name": "id",
              "type": "String"
            }
          ],
          "returns": {
            "type": "net.hollowcube.ipc.Blob"
          }
        },
        "list-traces": {
          "params": [
            {
              "name": "captureId",
              "type": "String"
            }
          ],
          "returns": {
            "type": "List\u003cnet.hollowcube.ipc.anticheat.TraceRow\u003e"
          }
        },
        "put-trace": {
          "params": [
            {
              "name": "meta",
              "type": "net.hollowcube.ipc.anticheat.TraceMeta"
            },
            {
              "name": "body",
              "type": "net.hollowcube.ipc.Blob"
            }
          ],
          "returns": {
            "type": "net.hollowcube.ipc.anticheat.PutResult"
          }
        }
      }
    },
